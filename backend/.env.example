# Copia in .env e compila. Non committare mai .env con valori reali.
#
# Nota: quasi tutti i campi qui sotto (Google/Bring!/Garmin, meteo) si
# possono anche impostare dalla pagina Impostazioni dell'app — se salvati lì
# vincono su questi, senza dover riaccedere al NUC. Questo file resta il
# fallback e il modo per compilarli la prima volta. Vedi
# backend/app/core/runtime_settings.py e ARCHITECTURE.md §7.1.1.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Login unico e condiviso di HomeHub (sostituisce la Basic Auth di nginx,
# vedi frontend/nginx.conf). Genera i due valori con
# `python scripts/generate_password_hash.py` (chiede la password a video,
# non va scritta qui in chiaro — lo script stampa già la riga pronta da
# incollare, coi "$" dell'hash raddoppiati: "docker compose" interpola
# anche il contenuto dei file caricati con "env_file:", quindi un hash
# bcrypt scritto con singoli "$" verrebbe troncato a metà, letto come
# riferimenti a variabili inesistenti). Lasciando APP_PASSWORD_HASH vuoto
# il login resta disattivato (tutte le richieste passano) — comodo appena
# dopo il deploy di questa funzionalità, da non lasciare così stabilmente.
APP_PASSWORD_HASH=
# Senza questa, ogni riavvio del backend disconnette tutti (ne viene
# generata una diversa al volo). Impostala una volta e non toccarla più.
SESSION_SECRET_KEY=
# true solo se HomeHub è servito in HTTPS (altrimenti il cookie di sessione
# "Secure" non verrebbe mai inviato dal browser, disconnettendo tutti).
SESSION_COOKIE_SECURE=false

# Postgres esistente sulla LAN, schema dedicato "homehub"
DATABASE_URL=postgresql+psycopg://homehub:CHANGE_ME@postgres.lan:5432/homehub
DATABASE_SCHEMA=homehub

# Google Calendar (OAuth2) — vedi TODO in app/adapters/google_calendar.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=["primary"]

# Bring! (API non ufficiale, integrazione reale attiva) — account dedicato o
# quello di famiglia. Finché lasci questi due campi vuoti, l'adapter usa una
# lista finta in memoria (utile per sviluppo/test senza toccare l'account vero).
BRING_EMAIL=
BRING_PASSWORD=

# Garmin Connect (API non ufficiale) — usata solo per leggere il piano
# pianificato (allenamenti assegnati ai giorni). Dopo aver compilato questi
# due campi, esegui una tantum `python scripts/garmin_login_setup.py` (serve
# un terminale interattivo, per l'eventuale codice MFA).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Schema "dieta" (stessa istanza Postgres di homehub, altra web app
# dell'utente): id in dieta.utente, usato sia per leggere gli allenamenti
# svolti da dieta.allenamento (invece che dalla sola API Garmin, dati più
# ricchi) sia per la cena di casa da dieta.menu_settimanale (il piano
# nutrizionale copre tutta la famiglia, non solo lui).
# Trovalo con: SELECT id FROM dieta.utente;
DIETA_USER_ID=

# Meteo (Open-Meteo, gratuita e senza chiave). WEATHER_CITY è sempre usata
# come etichetta mostrata in UI. Se compili anche LATITUDE/LONGITUDE, hanno
# la priorità per il meteo vero e proprio (coordinate esatte di casa invece
# del centro città, es. da Google Maps o Yandex Maps — click destro sul
# punto esatto sulla mappa): più precise soprattutto per l'avviso pioggia/neve.
WEATHER_CITY=Milano
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
