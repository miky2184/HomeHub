# Copia in .env e compila. Non committare mai .env con valori reali.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Postgres esistente sulla LAN, schema dedicato "homehub"
DATABASE_URL=postgresql+psycopg://homehub:CHANGE_ME@postgres.lan:5432/homehub
DATABASE_SCHEMA=homehub

# Google Calendar (OAuth2) — vedi TODO in app/adapters/google_calendar.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=["primary"]

# Bring! (API non ufficiale, integrazione reale attiva) — account dedicato o
# quello di famiglia. Finché lasci questi due campi vuoti, l'adapter usa una
# lista finta in memoria (utile per sviluppo/test senza toccare l'account vero).
BRING_EMAIL=
BRING_PASSWORD=

# Garmin Connect (API non ufficiale) — usata solo per leggere il piano
# pianificato (allenamenti assegnati ai giorni). Dopo aver compilato questi
# due campi, esegui una tantum `python scripts/garmin_login_setup.py` (serve
# un terminale interattivo, per l'eventuale codice MFA).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Schema "dieta" (stessa istanza Postgres di homehub, altra web app
# dell'utente): id in dieta.utente, per leggere gli allenamenti svolti da
# dieta.allenamento invece che dalla sola API Garmin (dati più ricchi).
# Trovalo con: SELECT id FROM dieta.utente;
DIETA_USER_ID=

# Meteo (Open-Meteo, gratuita e senza chiave) — nome città per la geolocalizzazione
WEATHER_CITY=Milano

# Web app esistenti: API key statica per-servizio (vedi ARCHITECTURE.md §9)
FINANCE_APP_BASE_URL=
FINANCE_APP_API_KEY=
MENU_APP_BASE_URL=
MENU_APP_API_KEY=
INVENTORY_APP_BASE_URL=
INVENTORY_APP_API_KEY=
