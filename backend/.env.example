# Copia in .env e compila. Non committare mai .env con valori reali.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Postgres esistente sulla LAN, schema dedicato "homehub"
DATABASE_URL=postgresql+psycopg://homehub:CHANGE_ME@postgres.lan:5432/homehub
DATABASE_SCHEMA=homehub

# Google Calendar (OAuth2) — vedi TODO in app/adapters/google_calendar.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=["primary"]

# Bring! (API non ufficiale) — account dedicato o quello di famiglia
BRING_EMAIL=
BRING_PASSWORD=

# Garmin Connect (API non ufficiale) — Fase 6, non ancora usata
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Web app esistenti: API key statica per-servizio (vedi ARCHITECTURE.md §9)
FINANCE_APP_BASE_URL=
FINANCE_APP_API_KEY=
MENU_APP_BASE_URL=
MENU_APP_API_KEY=
INVENTORY_APP_BASE_URL=
INVENTORY_APP_API_KEY=
